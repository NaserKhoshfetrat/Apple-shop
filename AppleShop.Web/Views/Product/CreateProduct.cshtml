@model AppleShop.Web.Models.ProductService.Dtos.IntegratedServices.Product.ProductDto

@{
    ViewData["Title"] = "Create Product";
}

<h1>Create Product</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="CreateProduct">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group pt-2">
                <div class="d-flex gap-2">
                    <input type="submit" value="Create" class="btn btn-primary flex-fill" />
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="form-group pt-2">
            <div class="d-flex gap-2">
                <a class="btn btn-secondary form-control flex-fill"
                   asp-area=""
                   asp-controller="Product"
                   asp-action="ProductIndex"
                   asp-route-pageIndex="0"
                   asp-route-pageSize="100">Back to products </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
