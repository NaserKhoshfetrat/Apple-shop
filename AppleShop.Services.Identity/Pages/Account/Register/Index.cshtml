@page "/Account/Register"
@model AppleShop.Services.Identity.Pages.Account.Register.RegisterModel
@{
}

<div class="login-page">
    <div class="lead">
        <h1>Register</h1>
        <p>Choose how to register</p>
    </div>

    <partial name="_ValidationSummary" />

    <div class="row">

        <div class="col-sm-6">
            <div class="card">
                <div class="card-header">
                    <h2>Local Account Register</h2>
                </div>

                <div class="card-body">
                    <form asp-page="/Account/Register/Index" method="post">
                        <input type="hidden" asp-for="View.ReturnUrl" />

                        <div class="form-group">
                            <label asp-for="View.Username"></label>
                            <input class="form-control" placeholder="Username" asp-for="View.Username" autofocus>
                        </div>
                        <div class="form-group">
                            <label asp-for="View.Email"></label>
                            <input class="form-control" placeholder="email" asp-for="View.Email" autofocus>
                        </div>
                        <div class="form-group">
                            <label asp-for="View.FirstName"></label>
                            <input class="form-control" placeholder="first name" asp-for="View.FirstName" autofocus>
                        </div>
                        <div class="form-group">
                            <label asp-for="View.LastName"></label>
                            <input class="form-control" placeholder="lastname" asp-for="View.LastName" autofocus>
                        </div>
                        <div class="form-group">
                            <label asp-for="View.Password"></label>
                            <input type="password" class="form-control" placeholder="Password" asp-for="View.Password" autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label asp-for="View.RoleName"></label>
                            @* <select asp-for="View.RoleName" class="form-control" asp-items="@(new SelectList(ViewBag.message))"></select> *@
                            <select asp-for="View.RoleName" class="form-control" asp-items="@(new SelectList(ViewData["message"] as List<string>))"></select>
                        </div>
                        <button class="btn btn-primary" name="button" value="Register">Register</button>
                        <button class="btn btn-secondary" name="button" value="cancel">Cancel</button>
                    </form>
                </div>
                <div class="card-footer">
                    <a asp-page="/Account/Login/Index" asp-route-ReturnUrl="@Model.View.ReturnUrl">
                        Login
                    </a>
                </div>
            </div>
        </div>


    </div>
</div>